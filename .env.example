# Clé API Anthropic pour l'assistant IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Base PostgreSQL (Supabase). Laisser vide pour utiliser la base SQLite de démo en mémoire.
# Supabase > Connect > Transaction pooler, avec le rôle en lecture seule :
# postgresql://querybuilder_ro.<project-ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optionnel : certificat CA Supabase (PEM, Database Settings > SSL) pour vérifier le TLS.
DATABASE_CA_CERT=
